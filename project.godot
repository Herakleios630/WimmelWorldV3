; WimmelWorld V3 - G1a Demo (sichtbarer Kern-Loop)
; Godot 4.7.2 stable, Standard-Build (GDScript), headless-faehig.

config_version=5

[application]

config/name="WimmelWorld V3 G1a"
config/description="G1a: sichtbarer, deterministischer Kern-Loop mit 10 Agenten."
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://tests/g1a/demo.tscn"
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_cast=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
