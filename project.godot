; WimmelWorld V3 — G0.5 Technikspike (wegwerfbar, kein Gameplay)
; Godot 4.7.2 stable, Standard-Build (GDScript), headless-fähig.

config_version=5

[application]

config/name="WimmelWorld V3 G0.5 Spike"
config/description="G0.5 technischer Messspike: Scheduler, SoA, Needs, Pfad, Batch, Save, Determinismus."
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://tests/spike/spike_all.tscn"
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_cast=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
